# Server Configuration
PROJECT_NAME="Intelligent Document Extraction Platform"
VERSION="1.0.0"
ENVIRONMENT="production"
PORT=8000
HOST="0.0.0.0"

# Storage & Database
DATABASE_URL="sqlite:///./documents.db"
UPLOAD_DIR="./uploads"

# Validation Parameters
MAX_PAGE_LIMIT=3
FINANCIAL_TOLERANCE=0.05

# LLM & OCR API Keys (Optional - Intelligent fallback rules active if empty)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OCR_ENGINE="hybrid"
